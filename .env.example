# The reviewer auto-detects the provider from whichever API key is set below.
# Set exactly one key, or set several and choose with --provider / PR_REVIEWER_PROVIDER.

# OpenAI (installed by default)
OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini

# Anthropic  (pip install "agentic-pr-reviewer[anthropic]")
# ANTHROPIC_API_KEY=your-key-here

# Google Gemini  (pip install "agentic-pr-reviewer[google]")
# GOOGLE_API_KEY=your-key-here

# Optional explicit overrides (otherwise inferred):
# PR_REVIEWER_PROVIDER=openai
# PR_REVIEWER_MODEL=gpt-4o-mini
